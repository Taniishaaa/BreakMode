# Copy to .env (never commit .env)

# Port for the Express server (the platform injects this in production)
PORT=3001

# Signs login sessions. Set a long random value in production (e.g. `openssl rand -hex 32`).
# If empty, a random secret is made on each start, so everyone is signed out whenever the server restarts.
AUTH_SECRET=

# Optional: Postgres. Leave empty to use the in-memory store (lost on restart).
# Hosted databases need TLS, e.g. ...?sslmode=require
# DATABASE_URL=postgres://bm:bm@localhost:5432/breakmode

# Optional: AI cards. Without a key every card is the template card and the app still works.
ANTHROPIC_API_KEY=
# Check current model names in the API docs
LLM_MODEL=claude-haiku-5-5
# Hard cap on model calls per hour, as a spend guard
LLM_MAX_CALLS_PER_HOUR=300
# Set to 1 to force template cards (failure drill for the demo)
LLM_FORCE_FAIL=
